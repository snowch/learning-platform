{
  "name": "learning-platform",
  "author": "Christopher Snow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The interactive learning platform the author's courses share: the lesson data format, the lesson runtime and the shared interaction primitives.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "vite-node scripts/export-schema.mts",
    "check": "./scripts/check.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
